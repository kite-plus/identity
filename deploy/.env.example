# Copy to deploy/.env on the server (chmod 600) and fill in every value.
# Never commit the filled-in file. See docs/runbooks/first-start.md.

# id.kite.plus in production, id.staging.kite.plus on staging. It becomes
# the issuer and can never change after the first start (R1).
IDENTITY_DOMAIN=id.staging.kite.plus

# Pinned ZITADEL version for both the API and the login UI image. Bump it
# only through docs/runbooks/upgrade.md.
ZITADEL_VERSION=v4.19.4

# Exactly 32 characters (openssl rand -hex 16). Cannot be changed after the
# first start; losing it makes the encrypted data unreadable. Keep two
# offline copies (architecture.md section 4).
ZITADEL_MASTERKEY=

# openssl rand -hex 24 each.
POSTGRES_ADMIN_PASSWORD=
ZITADEL_DB_PASSWORD=
# At least 32 characters (openssl rand -hex 32). A comma-separated list
# rotates it: the first value signs, all values verify.
LOGIN_SESSION_COOKIE_SECRET=

# First admin; changes the password on first sign-in and must set up MFA.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Bootstrap tokens written to $SECRETS_DIR/bootstrap on the first start.
# identity-init uses admin.pat; the login UI uses login-client.pat.
INIT_PAT_EXPIRATION=2027-12-31T00:00:00Z
LOGIN_PAT_EXPIRATION=2029-12-31T00:00:00Z
SECRETS_DIR=./secrets

# Let's Encrypt account contact. Use the staging directory
# https://acme-staging-v02.api.letsencrypt.org/directory for a dry run.
ACME_CONTACT=ops@kite.plus
ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory

# Used by identity-init (config/staging.yaml or config/production.yaml),
# not by the containers. Leave GitHub and Apple empty until the accounts
# exist; identity-init then skips them.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=

# Backups (scripts/backup.sh): age public key the dumps are encrypted to,
# and where they go.
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/var/backups/identity
