# Edge proxy (docker-compose.edge.yaml): a Caddy shared with other services
# on the server terminates TLS and reaches this proxy over the kite-edge
# network, on plain HTTP. Rendered by the nginx image's envsubst entrypoint;
# only ${IDENTITY_DOMAIN}, ${IDENTITY_SUBNET} and ${KITE_EDGE_SUBNET} are
# replaced.
load_module modules/ngx_http_js_module.so;

worker_processes auto;

events {
    worker_connections 4096;
}

http {
    server_tokens off;
    access_log /dev/stdout;
    error_log /dev/stderr warn;

    # Docker's DNS; upstreams are re-resolved when containers are recreated.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Caddy replaces X-Forwarded-For with the one address it settled on
    # (deploy/edge/identity.caddy), so the rate limits count readers. The
    # header is believed only from kite-edge, which only Caddy and the
    # services' own front containers join.
    set_real_ip_from ${KITE_EDGE_SUBNET};
    real_ip_header X-Forwarded-For;

    # Readers always come in over https at Caddy; ZITADEL and the login UI
    # would otherwise build http links.
    map $scheme $identity_scheme {
        default https;
    }

    include /etc/nginx/identity/backends.conf;

    server {
        listen 80 default_server;
        return 444;
    }

    server {
        listen 80;
        server_name ${IDENTITY_DOMAIN};
        # nginx itself is on http here; absolute redirects would send
        # readers to http:// first.
        absolute_redirect off;
        # Longer than Caddy's 2 minute idle timeout, so Caddy closes idle
        # upstream connections before nginx does and never sends on one.
        keepalive_timeout 180s;

        add_header Strict-Transport-Security "max-age=63072000" always;

        include /etc/nginx/identity/identity-locations.conf;
    }

    # Actions v2 target for new users' language (njs/reader_language.js).
    # The proxy also sits on kite-edge here, so only this compose network
    # may call it.
    server {
        listen 8082;
        access_log off;
        allow ${IDENTITY_SUBNET};
        deny all;
        client_body_buffer_size 64k;
        client_body_in_single_buffer on;

        location = /hooks/add-human-user {
            js_content reader_language.addHumanUser;
        }

        location / {
            return 404;
        }
    }
}
