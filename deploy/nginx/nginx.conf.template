# Production proxy. Rendered by the nginx image's envsubst entrypoint;
# only ${IDENTITY_DOMAIN}, ${ACME_CONTACT} and ${ACME_DIRECTORY} are
# replaced. TLS certificates come from the bundled ACME module.
load_module modules/ngx_http_js_module.so;
load_module modules/ngx_http_acme_module.so;

worker_processes auto;

events {
    worker_connections 4096;
}

http {
    server_tokens off;
    access_log /dev/stdout;
    error_log /dev/stderr warn;

    # Docker's DNS: the ACME module resolves the CA through it, and the
    # upstreams are re-resolved when containers are recreated on upgrade.
    resolver 127.0.0.11 valid=10s ipv6=off;

    acme_issuer letsencrypt {
        uri ${ACME_DIRECTORY};
        contact ${ACME_CONTACT};
        state_path /var/cache/nginx/acme/letsencrypt;
        accept_terms_of_service;
    }
    acme_shared_zone zone=acme_shared:1M;

    js_import sessions_cookie from /etc/nginx/identity/njs/sessions_cookie.js;

    include /etc/nginx/identity/limits.conf;

    upstream zitadel_api {
        zone zitadel_api 64k;
        server zitadel:8080 resolve;
        keepalive 32;
    }

    upstream zitadel_login {
        zone zitadel_login 64k;
        server login:3000 resolve;
        keepalive 32;
    }

    # Port 80 answers ACME HTTP-01 challenges and redirects everything else.
    server {
        listen 80 default_server;
        server_name ${IDENTITY_DOMAIN};

        location / {
            return 301 https://${IDENTITY_DOMAIN}$request_uri;
        }
    }

    # Unknown names get no certificate and no page.
    server {
        listen 443 ssl default_server;
        ssl_reject_handshake on;
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name ${IDENTITY_DOMAIN};

        acme_certificate letsencrypt;
        ssl_certificate $acme_certificate;
        ssl_certificate_key $acme_certificate_key;
        ssl_certificate_cache max=2;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:SSL:10m;

        add_header Strict-Transport-Security "max-age=63072000" always;

        include /etc/nginx/identity/identity-locations.conf;
    }

    # Container health check only.
    server {
        listen 127.0.0.1:8081;

        location = /healthz {
            access_log off;
            return 200 "ok\n";
        }
    }
}
